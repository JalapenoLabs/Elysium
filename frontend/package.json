{
  "name": "elysium-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --ignore-pattern \"**/*.mjs\" --max-warnings 0",
    "lint:fix": "eslint . --ignore-pattern \"**/*.mjs\" --fix",
    "test": "vitest run",
    "test:dev": "vitest",
    "generate:proto": "buf generate --template ../proto/buf.gen.yaml ../proto"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.12.1",
    "@heroui/react": "2.8.10",
    "@jalapenolabs/uikit": "https://github.com/JalapenoLabs/uikit.git#develop",
    "@reduxjs/toolkit": "2.12.0",
    "@serenity-kit/opaque": "^1.1.0",
    "@simplewebauthn/browser": "^13.3.0",
    "framer-motion": "12.42.2",
    "i18next": "^26.3.4",
    "i18next-http-backend": "^4.0.0",
    "jsonc-parser": "^3.3.1",
    "ky": "2.0.2",
    "moment-timezone": "^0.6.2",
    "qrcode.react": "^4.2.0",
    "rc-dock": "3.3.2",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-i18next": "^17.0.8",
    "react-icons": "^5.7.0",
    "react-redux": "9.3.0",
    "react-router": "8.1.0"
  },
  "devDependencies": {
    "@bufbuild/buf": "^1.71.0",
    "@bufbuild/protoc-gen-es": "^2.12.1",
    "@jalapenolabs/cli": "https://github.com/jalapenolabs/cli.git",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react-swc": "4.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "happy-dom": "^20.10.6",
    "playwright": "^1.61.1",
    "postcss": "^8.4.49",
    "tailwindcss": "3.4.19",
    "typescript": "^5.7.0",
    "vite": "8.1.3",
    "vitest": "^4.1.10"
  },
  "packageManager": "yarn@4.17.0"
}
