# Node / Yarn Berry (node-modules linker): keep the manifest and lockfile, ignore
# the installed tree and Yarn's generated internals.
node_modules
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions
.pnp.*

# TypeScript build output (compiled main + preload).
dist

# Electron Forge packaging output.
out

# Built installers, in case any land outside out/.
*.deb
*.rpm
*.AppImage
*.exe
*.msi
*.zip
