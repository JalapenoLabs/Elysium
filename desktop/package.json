{
  "name": "elysium-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Elysium desktop shell (Electron). Launches the dockerized Elysium app.",
  "author": "Jalapeno Labs LLC <opensource@jalapenolabs.io>",
  "license": "UNLICENSED",
  "homepage": "https://github.com/JalapenoLabs/Elysium",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -b",
    "watch": "tsc -b --watch",
    "dev": "concurrently --kill-others --names tsc,electron --prefix-colors blue,green \"tsc -b --watch\" \"electronmon .\"",
    "start": "electron-forge start",
    "typecheck": "tsc --noEmit",
    "package": "electron-forge package",
    "make": "electron-forge make"
  },
  "packageManager": "yarn@4.17.0",
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-deb": "7.11.2",
    "@electron-forge/maker-rpm": "7.11.2",
    "@electron-forge/maker-squirrel": "7.11.2",
    "@electron-forge/shared-types": "7.11.2",
    "@reforged/maker-appimage": "5.2.0",
    "@types/node": "26.1.0",
    "concurrently": "10.0.3",
    "electron": "43.0.0",
    "electronmon": "2.0.4",
    "ts-node": "10.9.2",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "electron-serve": "3.0.1"
  }
}
