{
  "name": "elysium-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Elysium desktop shell (Electron). Launches the dockerized Elysium app.",
  "author": "Jalapeno Labs LLC <opensource@jalapenolabs.io>",
  "license": "UNLICENSED",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -b",
    "watch": "tsc -b --watch",
    "dev": "concurrently --kill-others --names tsc,electron --prefix-colors blue,green \"tsc -b --watch\" \"electronmon .\"",
    "start": "electron .",
    "typecheck": "tsc --noEmit",
    "package:deb": "electron-builder --linux deb --publish never",
    "package:rpm": "electron-builder --linux rpm --publish never",
    "package:appimage": "electron-builder --linux AppImage --publish never",
    "package:windows": "electron-builder --win --publish never"
  },
  "packageManager": "yarn@4.17.0",
  "devDependencies": {
    "@types/node": "26.1.0",
    "concurrently": "10.0.3",
    "electron": "43.0.0",
    "electron-builder": "26.15.3",
    "electronmon": "2.0.4",
    "typescript": "6.0.3"
  }
}
