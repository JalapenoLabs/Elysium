{
  "compilerOptions": {
    // The Electron main and preload run in Node (the runtime Electron 43 ships,
    // Node 22 / ES2023). The package is ESM ("type": "module"), so emit ESM.
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],

    "outDir": "dist",
    "rootDir": "src",

    // Incremental project build (`tsc -b`), mirroring the frontend.
    "composite": true,
    "declaration": true,
    "sourceMap": true,
    "tsBuildInfoFile": "dist/tsconfig.tsbuildinfo",

    "esModuleInterop": true,
    "skipLibCheck": true,

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"]
}
