VERSION 0.8

# ---------------------------------------------------------------------------
# Elysium desktop shell (Electron) packaging.
#
# Produces installers for the Electron shell only. The web app is served by the
# dockerized stack at runtime and is deliberately NOT bundled here (see
# docs/desktop.md).
#
# Targets:
#   +deb       -> Linux .deb
#   +rpm       -> Linux .rpm
#   +appimage  -> Linux .AppImage
#   +windows   -> Windows NSIS installer (built on Linux via Wine)
#   +release   -> all of the above
#
# macOS (.dmg) is a later phase and requires an Apple-hosted (or macOS) builder;
# it cannot be produced on a Linux runner and is intentionally absent.
#
# Everything runs on the pinned Node image the rest of the repo uses, so the CI
# runner needs nothing beyond Earthly + its BuildKit daemon.
# ---------------------------------------------------------------------------

# Pinned to the exact Node used in CI and the frontend image (never a floating tag).
FROM node:24.13.0-slim
WORKDIR /desktop

# electron-builder downloads the matching Electron during packaging, so the npm
# postinstall binary download is redundant; skip it to keep installs lean.
ENV ELECTRON_SKIP_BINARY_DOWNLOAD=1

# Install node_modules in a layer cached until the manifest, lockfile, or the
# pinned Yarn release change.
deps:
    RUN corepack enable && corepack prepare yarn@4.17.0 --activate
    COPY package.json yarn.lock .yarnrc.yml ./
    RUN yarn install --immutable

# Compile the TypeScript main + preload. Kept separate from +deps so source-only
# changes don't invalidate the dependency layer.
build:
    FROM +deps
    COPY tsconfig.json electron-builder.yml ./
    COPY src ./src
    COPY static ./static
    RUN yarn build

# Adds the system tooling electron-builder shells out to for Linux packaging:
#   dpkg + fakeroot -> .deb, rpm/rpmbuild -> .rpm, libarchive/xz -> archives.
linux-builder:
    FROM +build
    RUN apt-get update \
        && apt-get install -y --no-install-recommends \
            ca-certificates \
            fakeroot \
            dpkg \
            rpm \
            libarchive-tools \
            xz-utils \
        && rm -rf /var/lib/apt/lists/*
    # Containers have no FUSE, so appimagetool must extract-and-run instead of
    # mounting itself. Without this, AppImage packaging fails in CI.
    ENV APPIMAGE_EXTRACT_AND_RUN=1

deb:
    FROM +linux-builder
    # Keep Electron and app-builder downloads warm across builds of this target.
    CACHE /root/.cache/electron
    CACHE /root/.cache/electron-builder
    RUN yarn package:deb
    SAVE ARTIFACT release/*.deb AS LOCAL release/

rpm:
    FROM +linux-builder
    CACHE /root/.cache/electron
    CACHE /root/.cache/electron-builder
    RUN yarn package:rpm
    SAVE ARTIFACT release/*.rpm AS LOCAL release/

appimage:
    FROM +linux-builder
    CACHE /root/.cache/electron
    CACHE /root/.cache/electron-builder
    RUN yarn package:appimage
    SAVE ARTIFACT release/*.AppImage AS LOCAL release/

# Windows installer, cross-built on Linux. Wine lets electron-builder run the
# NSIS toolchain; the i386 architecture is required for its 32-bit components.
windows:
    FROM +build
    RUN dpkg --add-architecture i386 \
        && apt-get update \
        && apt-get install -y --no-install-recommends \
            ca-certificates \
            wine \
            wine64 \
            wine32 \
        && rm -rf /var/lib/apt/lists/*
    CACHE /root/.cache/electron
    CACHE /root/.cache/electron-builder
    RUN yarn package:windows
    SAVE ARTIFACT release/*.exe AS LOCAL release/

# Build every installer in one shot. The targets are independent, so BuildKit
# runs them in parallel.
release:
    BUILD +deb
    BUILD +rpm
    BUILD +appimage
    BUILD +windows
