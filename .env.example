# Copy this file to `.env` and adjust as needed.
# `.env` is git-ignored; never commit real secrets.

# ---------------------------------------------------------------------------
# Deployment: hostname + ports. Every Keycloak / OIDC / CORS / login URL is
# derived from these, so this is the only place to change the host or a port.
#
# The var is ELYSIUM_HOSTNAME, not HOSTNAME: Docker auto-sets HOSTNAME to the
# container id and the host shell sets it to the machine name, so the bare name
# is unusable.
# ---------------------------------------------------------------------------
ELYSIUM_HOSTNAME=localhost
API_PORT=31416
FRONTEND_PORT=5173
KEYCLOAK_PORT=8080
KEYCLOAK_REALM=elysium
RUST_LOG=info,elysia_backend=debug

# ---------------------------------------------------------------------------
# Secrets. Avoid `$` in any value: Docker Compose treats it as interpolation.
# ---------------------------------------------------------------------------
# Confidential OIDC client secret (matches the realm import; regenerate in prod).
OIDC_CLIENT_SECRET=dev-elysium-api-secret-change-in-prod

# Application Postgres.
POSTGRES_USER=elysia_keeper
POSTGRES_PASSWORD=zR7p-Km4wLnQ2xVt!8
POSTGRES_DB=elysia
POSTGRES_PORT=5432

# Keycloak master-realm bootstrap admin (admin console only; not an app user).
KEYCLOAK_ADMIN=elysium_warden
KEYCLOAK_ADMIN_PASSWORD=Vg9-tsKp2mQ7hLxD

# Dedicated Keycloak Postgres.
KEYCLOAK_DB_USER=kc_gatekeeper
KEYCLOAK_DB_PASSWORD=Jm4-nBq8TzLw2rS!
KEYCLOAK_DB_NAME=elysium_keycloak
