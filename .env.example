# Development environment. `yarn dev` copies this to `.env` on first run, so
# edit `.env` rather than this file once it exists.
#
# Nothing here is a production credential. Production values come from the
# deployment, never from a file in the repository.

# The development datastore, matching compose.yaml. The password avoids `#`,
# `@`, `:`, and `/` deliberately: it is interpolated into DATABASE_URL below,
# where those characters change what the URL means.
POSTGRES_USER=arsox_pilot
POSTGRES_PASSWORD=Kestrel_7Vault-Ridge.42
POSTGRES_DB=arsox_development
POSTGRES_PORT=54321

DATABASE_URL=postgres://arsox_pilot:Kestrel_7Vault-Ridge.42@localhost:54321/arsox_development

# The origin the browser sees. Emailed action links and OAuth redirect URIs are
# built from it, which is why development points it at the vite dev server
# rather than at the backend on port 3000.
APP_URL=http://localhost:5173

# Seals secrets at rest: satellite bearer tokens, LLM and repository
# credentials, and the framework's TOTP secrets.
#
# Left unset here on purpose. Anubis falls back to a fixed, public development
# key so a fresh checkout boots with no configuration, and warns at startup
# that it did. Production refuses to start without a real one.
#
# Generate one per environment with `openssl rand -base64 32` and keep it:
# rotating the key makes every value already sealed under it unreadable.
#
# ANUBIS_SECRET_KEY=
