# Copy to .env and fill in. Only bootstrap credentials belong here: application secrets
# (LLM tokens and the like) are stored encrypted in Postgres, and other configuration is
# inline in compose.yml. See docs/secrets.md.

# Postgres. Passwords are embedded in connection URLs unencoded: use letters, digits, - _ . ~ only.
# Postgres applies these only when its data volume is first created.
POSTGRES_USER=elysium_keeper
POSTGRES_PASSWORD=
POSTGRES_DB=elysium

# Redis. Same character rules as the Postgres password.
REDIS_PASSWORD=

# Encrypts every secret stored in Postgres. Losing it makes them unrecoverable. Generate one with:
#   docker compose run --rm --no-deps api elysium-api generate-encryption-key
ELYSIUM_ENCRYPTION_KEY=

# Optional tracing filter for the API.
# RUST_LOG=info,tower_http=info

# Optional web bind address. Everyone who signs in shares the workspace, including stored credentials and
# control of the Docker host, so widen this only for a network whose users may all hold accounts.
# WEB_BIND_ADDRESS=127.0.0.1

# Optional: the origin browsers reach Elysium at, http://localhost:<WEB_PORT> unless set. Sessions and passkeys are
# bound to it, so anything reached from other machines must be https with a host name. See docs/auth.md.
# ELYSIUM_PUBLIC_URL=https://elysium.example.com

# Optional: the proxy in front of nginx, such as a TLS terminator, as an address or CIDR. nginx then reads the
# client's address from its X-Forwarded-For, which the sign-in throttle needs. Unset trusts nobody.
# TRUSTED_PROXY_ADDRESSES=10.0.0.0/8

# Optional host ports. Mail from other servers must reach port 25 on the public side,
# so move these only when something on the host already holds them.
# WEB_PORT=4000
# SMTP_PORT=25
# SUBMISSIONS_PORT=465
# IMAPS_PORT=993
