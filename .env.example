# Copy this file to `.env` and adjust as needed.
# `.env` is git-ignored; never commit real secrets.
#
# This file holds only what is needed to boot and protect the box: the infra
# service credentials, the deployment host/ports, the master encryption key, and
# the optional data directory. Everything operational (the upload cap, Drives,
# storage settings, ...) is configured in-app and stored in the database, never
# here. See docs/storage.md ("Configuration philosophy").

# ---------------------------------------------------------------------------
# Deployment: hostname + ports. The app origin and the WebAuthn Relying Party
# are derived from these, so this is the only place to change the host or a port.
#
# The var is ELYSIUM_HOSTNAME, not HOSTNAME: Docker auto-sets HOSTNAME to the
# container id and the host shell sets it to the machine name, so the bare name
# is unusable.
# ---------------------------------------------------------------------------
ELYSIUM_HOSTNAME=localhost
API_PORT=31416
FRONTEND_PORT=5173
RUST_LOG=info,elysium_backend=debug

# ---------------------------------------------------------------------------
# Secrets. Avoid `$` in any value: Docker Compose treats it as interpolation.
# ---------------------------------------------------------------------------
# Application Postgres.
POSTGRES_USER=elysium_keeper
POSTGRES_PASSWORD=zR7p-Km4wLnQ2xVt!8
POSTGRES_DB=elysium
POSTGRES_PORT=5432

# Master key for encrypting secrets at rest (the OPAQUE server setup and every
# TOTP secret). Required: the backend refuses to start without it. Generate a
# fresh one per deployment with `openssl rand -base64 32` and keep it safe;
# losing or changing it makes those stored secrets permanently unreadable.
ELYSIUM_SECRET_KEY=IdaB8VWW3Z/tIt8CHu93peot7utm3ld9+ZSP5NuR2hs=

# Base directory Elysium may write local files to. Optional: defaults to
# /var/lib/elysium, the writable volume mounted in compose.yaml. Auto-provisioned
# local-FS Drives root under it (<data_dir>/<org_id>/<project_id>); the resolved
# root is persisted per Drive, so changing this never orphans an existing Drive.
# The per-file upload cap is a database setting (org_storage_settings), not an env
# var. Mounting a writable volume is the only storage deployment concern.
# ELYSIUM_DATA_DIR=/var/lib/elysium

# Scoped Docker Engine API endpoint for the orchestration provisioner. Defaults
# to the socket-proxy service in compose.yaml (http://socket-proxy:2375), which
# is the only container that sees the host Docker socket. Set it empty to disable
# real container provisioning and use the in-memory backend instead. Point it at
# a rootless Podman Docker-compatible socket to run on Podman (same code path).
# ELYSIUM_DOCKER_PROXY_URL=http://socket-proxy:2375

# ---------------------------------------------------------------------------
# Redis (cache / ephemeral state).
# ---------------------------------------------------------------------------
REDIS_PORT=31417
REDIS_PASSWORD=eLy-rD8sKw3pQm7Xv

# ---------------------------------------------------------------------------
# IP geolocation (see docs/geoip.md). Turns raw IPs in the session and sign-in
# views into a city / country. Best-effort and cached in Redis; sends client IPs
# to the endpoint below. Set ELYSIUM_GEOIP_ENABLED=false to keep every IP local.
# ELYSIUM_GEOIP_ENDPOINT must return ipwho.is-compatible JSON and end with a slash.
# ---------------------------------------------------------------------------
ELYSIUM_GEOIP_ENABLED=true
ELYSIUM_GEOIP_ENDPOINT=https://ipwho.is/

# ---------------------------------------------------------------------------
# RabbitMQ (message broker; management UI on the second port).
# ---------------------------------------------------------------------------
RABBITMQ_PORT=31418
RABBITMQ_MANAGEMENT_PORT=31419
RABBITMQ_USER=elysia_courier
RABBITMQ_PASSWORD=eLy-mQ5tBn9wRk2Jd
