# Copy this file to `.env` and adjust as needed.
# `.env` is git-ignored; never commit real secrets.

# ---------------------------------------------------------------------------
# Postgres
# ---------------------------------------------------------------------------
POSTGRES_USER=elysia_keeper
# Avoid `$` in this value: Docker Compose treats it as variable interpolation.
POSTGRES_PASSWORD=zR7p-Km4wLnQ2xVt!8
POSTGRES_DB=elysia
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# Backend (Rust API)
# ---------------------------------------------------------------------------
API_PORT=31416
RUST_LOG=info,elysia_backend=debug
# Token validation. The issuer is the browser-facing realm URL (so it matches
# tokens clients present); the JWKS is fetched over the internal Docker network.
KEYCLOAK_ISSUER=http://localhost:8080/realms/elysium
KEYCLOAK_JWKS_URL=http://keycloak:8080/realms/elysium/protocol/openid-connect/certs

# ---------------------------------------------------------------------------
# Frontend (Vite)
# ---------------------------------------------------------------------------
FRONTEND_PORT=5173
# Base URL the browser uses to reach the API. Because the API port is
# published to the host, `localhost` is correct when running via Compose.
VITE_API_BASE_URL=http://localhost:31416
# Where the browser reaches Keycloak for the OIDC login redirect (Phase D).
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=elysium
VITE_KEYCLOAK_CLIENT_ID=elysium-frontend

# ---------------------------------------------------------------------------
# Keycloak (identity provider)
#
# Keycloak owns all credentials and runs every login ceremony (passkey, TOTP).
# It uses its own Postgres, isolated from the application database above.
# Avoid `$` in any value: Docker Compose treats it as variable interpolation.
# ---------------------------------------------------------------------------
KEYCLOAK_PORT=8080
KEYCLOAK_REALM=elysium
# Pinned public base URL, so issuers are stable across browser and in-cluster access.
KEYCLOAK_HOSTNAME_URL=http://localhost:8080
# Bootstrap superuser for the Keycloak master realm (admin console only; this is
# NOT an application user). Application users live in the `elysium` realm.
KEYCLOAK_ADMIN=elysium_warden
KEYCLOAK_ADMIN_PASSWORD=Vg9-tsKp2mQ7hLxD
# Dedicated Keycloak database credentials.
KEYCLOAK_DB_USER=kc_gatekeeper
KEYCLOAK_DB_PASSWORD=Jm4-nBq8TzLw2rS!
KEYCLOAK_DB_NAME=elysium_keycloak
