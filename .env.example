# Copy this file to `.env` and adjust as needed.
# `.env` is git-ignored; never commit real secrets.

# ---------------------------------------------------------------------------
# Postgres
# ---------------------------------------------------------------------------
POSTGRES_USER=elysia_keeper
# Avoid `$` in this value: Docker Compose treats it as variable interpolation.
POSTGRES_PASSWORD=zR7p-Km4wLnQ2xVt!8
POSTGRES_DB=elysia
POSTGRES_PORT=5432

# ---------------------------------------------------------------------------
# Backend (Rust API)
# ---------------------------------------------------------------------------
API_PORT=31416
RUST_LOG=info,elysia_backend=debug

# ---------------------------------------------------------------------------
# Frontend (Vite)
# ---------------------------------------------------------------------------
FRONTEND_PORT=5173
# Base URL the browser uses to reach the API. Because the API port is
# published to the host, `localhost` is correct when running via Compose.
VITE_API_BASE_URL=http://localhost:31416
