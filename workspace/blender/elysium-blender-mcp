#!/usr/bin/env bash
# Copyright © 2026 Jalapeno Labs
#
# One turn's Blender, as an MCP server on standard input and output. Claude Code starts it for the
# turn's `blender` MCP server and stops it when the turn ends, so every turn models in a Blender of
# its own and no two turns share a scene.
#
# It starts headless Blender with the MCP bridge on a free loopback port, waits for it to listen,
# then runs Blender Lab's MCP server against it in the foreground. Standard output belongs to the
# MCP protocol, so Blender's own output goes to standard error. Blender stops when this script ends.

set -euo pipefail

# How long a cold Blender may take to load the extension and listen.
readonly BRIDGE_START_SECONDS=60

port=$(python3 -c 'import socket; s = socket.socket(); s.bind(("127.0.0.1", 0)); print(s.getsockname()[1]); s.close()')

blender --background --online-mode --command blender_mcp --host 127.0.0.1 --port "$port" 1>&2 &
bridge=$!
trap 'kill "$bridge" 2>/dev/null || true' EXIT

for _ in $(seq 1 $((BRIDGE_START_SECONDS * 2))); do
    if (exec 3<>"/dev/tcp/127.0.0.1/$port") 2>/dev/null; then
        break
    fi
    if ! kill -0 "$bridge" 2>/dev/null; then
        echo "elysium-blender-mcp: Blender exited before its bridge listened" >&2
        exit 1
    fi
    sleep 0.5
done

BLENDER_PATH=/opt/blender/blender BLENDER_MCP_HOST=127.0.0.1 BLENDER_MCP_PORT="$port" blender-mcp
