# Copy to oauth-broker/.env and fill in. This file configures the broker only; nothing
# here belongs in an Elysium instance's .env.

# Where browsers reach the broker, without a trailing slash. Register
# <BROKER_PUBLIC_URL>/v1/callback/google and <BROKER_PUBLIC_URL>/v1/callback/microsoft
# as redirect URIs on the OAuth apps below.
BROKER_PUBLIC_URL=http://localhost:4100

# Seals state and handoff tokens. Every replica must share it. Generate one with:
#   openssl rand -base64 32
BROKER_SEALING_KEY=

# At least one provider. Leave a pair empty to disable that provider.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Optional: move the published port off 4100.
# BROKER_PORT=4100
