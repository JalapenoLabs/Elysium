{
  "$id": "https://schemas.elysium.local/person-v2.schema.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Person",
  "type": "object",
  "properties": {
    "traits": {
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "format": "email",
          "title": "Email",
          "minLength": 3,
          "maxLength": 320,
          "ory.sh/kratos": {
            "credentials": {
              "password": {
                "identifier": true
              },
              "passkey": {
                "display_name": true
              },
              "totp": {
                "account_name": true
              }
            },
            "recovery": {
              "via": "email"
            }
          }
        },
        "name": {
          "type": "object",
          "title": "Name",
          "properties": {
            "first": {
              "type": "string",
              "title": "First name",
              "minLength": 1,
              "pattern": "\\S",
              "maxLength": 50
            },
            "last": {
              "type": "string",
              "title": "Last name",
              "maxLength": 50
            }
          },
          "required": [
            "first"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "email",
        "name"
      ],
      "additionalProperties": false
    }
  }
}
